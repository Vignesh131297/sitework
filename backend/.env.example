# Copy to .env and fill in. Never commit .env.
# Values here are placeholders; generate real secrets (e.g. 64 random characters).

NODE_ENV=development
# 127.0.0.1 locally (the Android emulator reaches it as 10.0.2.2); 0.0.0.0 in containers.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# PostgreSQL. The local setup script prints both URLs (see README: Local database).
DATABASE_URL=postgresql://sitework:CHANGE_ME@localhost:5432/sitework?schema=public
# Used only by `npm run test:e2e`; must be a separate database.
TEST_DATABASE_URL=postgresql://sitework:CHANGE_ME@localhost:5432/sitework_test?schema=public

# Auth. At least 32 random characters each, different from each other.
# JWT_REFRESH_SECRET also peppers refresh-token and reset-code hashes.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_1
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_2
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# E-mail for password-reset codes: disabled (admins reset passwords) | log (development) | smtp
MAIL_DRIVER=log
MAIL_FROM=SiteWork <no-reply@sitework.example>
# Required when MAIL_DRIVER=smtp, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=

# Photo storage: local (development) | supabase
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Required when STORAGE_DRIVER=supabase. The service key must never reach the app.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=sitework-private

# Behind a load balancer or reverse proxy: how many proxies sit in front (usually 1),
# or their addresses ("loopback, 10.0.0.0/8"). false when clients connect directly.
TRUST_PROXY=false

# Mobile numbers (comma-separated) whose password can't be changed or reset in any
# way, e.g. a shared admin while the app is being tried out. Empty: none.
PASSWORD_LOCKED_PHONES=

# Requests per minute per signed-in user. Sign-in and password reset have fixed, stricter limits.
RATE_LIMIT_PER_MINUTE=300

# Scheduled jobs: missed-update alerts, photo deletion, auto-absent. Run them on one
# instance or many (they take a database lock); set false only for tests or tooling.
JOBS_ENABLED=true

# Push notifications: log (development) | fcm
PUSH_DRIVER=log
# Required when PUSH_DRIVER=fcm (Firebase service account).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
